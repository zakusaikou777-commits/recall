{
  "manifest_version": 3,
  "name": "Recall — 復習ブックマーク",
  "short_name": "Recall",
  "version": "1.9.0",
  "description": "ワンクリックでページを保存。カテゴリ・タグで整理して、忘却曲線に沿ったタイミングで復習を通知します。",
  "key": "",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "tabs",
    "activeTab",
    "contextMenus",
    "favicon",
    "scripting",
    "identity"
  ],
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Recall に保存 (Alt+S)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "library.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "現在のページを Recall に保存"
    },
    "open-library": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Recall ライブラリを開く"
    },
    "quick-save": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "確認なしで即保存（未分類）"
    }
  },
  "omnibox": {
    "keyword": "rc"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
